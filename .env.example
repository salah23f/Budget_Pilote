# ============================================================
# Flyeas — variables d'environnement
#
# Toutes les valeurs ci-dessous sont FACTICES : remplacez-les.
# [REQUIS]   = l'app est cassée ou dégradée sans cette variable
# [OPTIONNEL]= la feature concernée se désactive proprement
# ============================================================

# Supabase
# [REQUIS] URL du projet Supabase. Absente → supabaseAdmin = null : /api/user/*,
#          /api/notifications, /api/group-trips, /api/trips répondent 503 et
#          l'app retombe sur localStorage.
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
# [REQUIS] Clé publique navigateur (lib/supabase.ts, supabase-middleware).
#          Absente → pas de session Supabase côté client : login et onboarding KO.
NEXT_PUBLIC_SUPABASE_ANON_KEY=<votre-cle-anon-supabase>
# [REQUIS] Clé service role (serveur uniquement, bypasse RLS).
#          Absente → toutes les écritures serveur sont des no-op silencieux.
SUPABASE_SERVICE_ROLE_KEY=<votre-cle-service-role-supabase>
# [OPTIONNEL] Alias legacy lu UNIQUEMENT par app/api/subscribe/route.ts.
#             Absente → l'inscription newsletter n'est pas persistée (l'email
#             de bienvenue part quand même). À terme : migrer la route sur
#             SUPABASE_SERVICE_ROLE_KEY et supprimer cette variable.
SUPABASE_SERVICE_KEY=<votre-cle-service-supabase>

# RapidAPI — single key for all 6 flight APIs
# Sky Scrapper (PAID PRO): sky-scrapper.p.rapidapi.com
# Air Scraper (free): air-scraper.p.rapidapi.com
# Kiwi.com (free): kiwi-com-cheap-flights.p.rapidapi.com
# Booking COM (free): booking-com15.p.rapidapi.com
# Google Flights2 (free): google-flights2.p.rapidapi.com
# WeatherAPI (free, 1M/mo): weatherapi-com.p.rapidapi.com
# [REQUIS] Absente → TOUS les providers vols/hôtels/voitures se déclarent non
#          configurés : aucune recherche ne renvoie de résultat.
RAPIDAPI_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# [OPTIONNEL] Hôte par défaut. Plus lu par le code aujourd'hui (chaque client
#             RapidAPI code son propre host) — conservé pour compatibilité.
RAPIDAPI_HOST=sky-scrapper.p.rapidapi.com

# Amadeus (backup flight provider, FREE 2000 calls/month)
# [OPTIONNEL] Les deux ensemble activent le provider de secours
#             (isAmadeusConfigured). Absentes → on reste sur RapidAPI seul.
AMADEUS_CLIENT_ID=xxxxxAmadeusClientIdxxxxx
AMADEUS_CLIENT_SECRET=xxxxxAmadeusSecretxxxxx
# [OPTIONNEL] 'test' | 'production'. Toute autre valeur (ou absence) = test.
AMADEUS_ENV=test

# OpenWeather (météo destination)
# [OPTIONNEL] Absente → /api/weather ne renvoie pas de prévisions ; les écrans
#             qui l'affichent masquent simplement le bloc météo.
OPENWEATHER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Scraper & cron (secrets d'appel machine-à-machine)
# [REQUIS pour le pipeline de données] Protège /api/scraper/run (GET et POST).
#          Absente → la route répond 500 « SCRAPER_SECRET not configured » et le
#          cron GitHub Actions n'ingère plus aucun prix. Générer : openssl rand -hex 32
SCRAPER_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# [REQUIS en prod] Bearer des jobs cron Vercel. Absente → fail-closed :
#          /api/setup/stripe-webhook refuse, et /api/missions/[id]/propose ne
#          reconnaît plus l'appelant cron (donc aucun auto-buy possible).
CRON_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Agent V7 / V7a
# [OPTIONNEL] Version de l'algo : v1 (défaut) | v7 | shadow.
FLYEAS_ALGO_VERSION=shadow
# [OPTIONNEL] 'true' arme l'achat automatique du watcher. Absente ou toute autre
#             valeur → l'agent ne déclenche JAMAIS d'achat (défaut voulu).
FLYEAS_AUTOBUY_ENABLED=false
# [OPTIONNEL] Endpoint Modal du modèle V7a (POST <url>/predict).
#             Absente → V7a indisponible, le moteur retombe sur V1.
MODAL_V7A_URL=https://example--flyeas-v7a.modal.run
# [OPTIONNEL] Bearer envoyé à MODAL_V7A_URL. Absente/incorrecte → 401 côté Modal,
#             donc fallback V1 silencieux.
MODAL_V7A_SECRET=xxxxxModalSecretxxxxx
# [OPTIONNEL] Taille du balayage shadow de démo (défaut 2).
DEMO_SHADOW_ROUTES_PER_RUN=2
# [OPTIONNEL] Parallélisme du balayage shadow de démo (défaut 2).
DEMO_SHADOW_CONCURRENCY=2

# Anthropic Claude (chatbot)
# [OPTIONNEL] Absente → /api/chat retombe sur le moteur rule-based (réponses
#             plus pauvres, mais l'endpoint continue de fonctionner).
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxx

# Resend (email alerts)
# [OPTIONNEL] Absente → aucun email n'est envoyé (bienvenue newsletter,
#             invitation group-trip, parrainage) ; les routes n'échouent pas.
RESEND_API_KEY=<votre-cle-api-resend>
# [OPTIONNEL] Expéditeur de /api/referral/send. Défaut : Flyeas <hello@flyeas.app>
RESEND_FROM=Flyeas <hello@example.com>
# [OPTIONNEL] Legacy : plus lue par le code (les routes hardcodent leur `from`).
ALERT_FROM_EMAIL=alerts@example.com

# Stripe (payments — flux d'autorisation à capture manuelle)
# [REQUIS pour les paiements] Absente → getStripe() lève
#          « STRIPE_SECRET_KEY is not configured » : plus aucune autorisation carte.
STRIPE_SECRET_KEY=<votre-cle-secrete-stripe>
# [REQUIS pour les paiements] Clé publique du formulaire carte.
#          Absente → le composant de paiement ne monte pas côté client.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<votre-cle-publique-stripe>
# [REQUIS si webhook branché] Signature whsec_... vérifiée par
#          /api/webhooks/stripe. Absente → les événements Stripe sont rejetés,
#          les statuts de paiement ne se mettent plus à jour.
STRIPE_WEBHOOK_SECRET=<votre-secret-webhook-stripe>

# Auth / OTP email
# [OPTIONNEL mais fortement recommandé] Clé HMAC des codes de connexion.
#             Absente → fallback sur RAPIDAPI_KEY, puis sur la constante en dur
#             'flyeas-dev-secret-change-me' : codes OTP forgeables en prod.
OTP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Application
# [OPTIONNEL] Base URL publique. Absente → défaut https://faregenie.vercel.app
#             (liens de partage de trip et callback webhook pointent dessus).
NEXT_PUBLIC_APP_URL=https://example.vercel.app

# Debug (ne jamais activer en production)
# [OPTIONNEL] '1' ouvre /api/debug/deploy (exécution shell). Toute autre valeur
#             ou absence → la route refuse. Laisser vide.
ALLOW_DEPLOY_SHELL=

# Injecté automatiquement par Vercel — NE PAS définir à la main :
#   VERCEL_GIT_COMMIT_SHA  → /api/status affiche le build ('dev' en local)
#   NODE_ENV               → géré par Next.js

# ============================================================
# Rail crypto / wallet — [DÉSACTIVÉ — rail masqué]
# Cette couche est volontairement inactive : ne rien renseigner ici tant que
# le rail n'est pas rouvert. Laissées vides, les routes concernées refusent
# proprement (« Wallet rail is not configured ») et l'UI wallet reste masquée.
# ============================================================
# [OPTIONNEL — rail masqué] Login Privy + wallets embarqués. Vide → AuthCard
#             affiche l'état « non configuré », pas de wallet embarqué.
NEXT_PUBLIC_PRIVY_APP_ID=
# [OPTIONNEL — rail masqué] 'base' | 'optimism' | 'arbitrum' | 'polygon' (défaut base).
NEXT_PUBLIC_ESCROW_CHAIN=
# [OPTIONNEL — rail masqué] Chain id lu par l'écran de paiement wallet (défaut 8453).
NEXT_PUBLIC_ESCROW_CHAIN_ID=
# [OPTIONNEL — rail masqué] Adresse du contrat MissionEscrow. Vide →
#             /api/missions/create refuse la création d'une mission wallet.
NEXT_PUBLIC_ESCROW_ADDRESS=
# [OPTIONNEL — rail masqué] Adresse USDC sur la chaîne choisie.
NEXT_PUBLIC_ESCROW_USDC=
# [OPTIONNEL — rail masqué] Adresse marchand whitelistée (ops Flyeas). Vide →
#             même refus que ci-dessus côté création de mission.
NEXT_PUBLIC_ESCROW_MERCHANT=
# [OPTIONNEL — rail masqué] Clé privée serveur autorisée à appeler agentRelease().
#             Vide → escrow.ts lève « AGENT_PRIVATE_KEY is not configured » si
#             un release on-chain est tenté. NE JAMAIS committer de vraie clé.
AGENT_PRIVATE_KEY=
# [OPTIONNEL — rail masqué] RPC custom ; vide → RPC public par défaut de viem.
ESCROW_RPC_URL=
# [OPTIONNEL — rail masqué] Contrat de reçu on-chain (BookOnchainButton).
#             Vide → le bouton affiche « Missing NEXT_PUBLIC_RECEIPT_CONTRACT ».
NEXT_PUBLIC_RECEIPT_CONTRACT=
# [OPTIONNEL — rail masqué] Chain id de destination du reçu (défaut 11155420).
NEXT_PUBLIC_DEST_CHAIN_ID=
